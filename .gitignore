.DS_Store
.claude/worktrees/
# generated by scripts/trace-matrix.sh
specs/**/matrix.html

# Python adapter validation artifacts
__pycache__/
*.pyc

# Local run state is retained on disk, never published.
.sdlc-openai/

# Files the engine lays beside a loaded mod (REQ-MOD-025); the installer skips
# the same names.
adapters/claude/skills/*/.claude-plugin/types/
adapters/claude/skills/*/tsconfig.json
adapters/claude/skills/*/node_modules/
